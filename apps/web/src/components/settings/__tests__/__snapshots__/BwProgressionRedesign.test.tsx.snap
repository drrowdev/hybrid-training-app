// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BwProgressionFamilyRow > matches the compact-row snapshot 1`] = `"<div data-testid="bw-family-row-push_h" style="display:grid;gap:8px;padding:12px 14px;border:1px solid var(--cp-border);border-radius:10px;background:var(--cp-surface)"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap"><div style="display:flex;flex-direction:column;min-width:0"><span style="font-size:11px;color:var(--cp-text-muted);text-transform:none;letter-spacing:0">Horizontal push</span><span style="font-size:14px;font-weight:600">Push-up</span></div><span style="font-size:11px;color:var(--cp-text-muted)">Next: <strong style="color:var(--cp-text)">Archer push-up</strong></span></div><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><select data-testid="bw-family-row-select-push_h" style="flex:1 1 200px;min-width:0;padding:5px 8px;border-radius:8px;border:1px solid var(--cp-border);background:var(--cp-surface);color:var(--cp-text);font-size:13px"><option value="n-entry">Wall push-up · anchor 10</option><option value="n-mid" selected="">Push-up · anchor 30</option><option value="n-adv">Archer push-up · anchor 60</option></select></div><div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:11px;color:var(--cp-text-muted);line-height:1.5"><span data-testid="bw-row-weeks-push_h">weeks 1/2</span><span style="flex:1 1 90px;min-width:90px"><span style="display:block;margin-bottom:2px">TUT 124/252 sec</span><span data-testid="bw-row-tut-bar-push_h" style="display:block;height:5px;border-radius:3px;background:var(--cp-border);overflow:hidden"><span style="display:block;width:49%;height:100%;background:var(--cp-accent, var(--cp-text))"></span></span></span></div></div>"`;
