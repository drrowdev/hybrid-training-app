{
  "name": "hybrid-training-app",
  "version": "0.0.0",
  "private": true,
  "description": "Science-informed hybrid training with adaptive load management — public-ready multi-user training app",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @hta/web dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @hta/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:generate": "pnpm --filter @hta/db db:generate",
    "db:migrate": "pnpm --filter @hta/db db:migrate",
    "docs:check-drift": "node scripts/check-doc-drift.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vercel": "^54.1.0",
    "vitest": "^2.1.9"
  }
}
