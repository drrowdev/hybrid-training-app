{
  "name": "@hta/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "echo '(no lint config yet)'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/normalize-migrations-lf.ts && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx seeds/run.ts",
    "db:seed:bw": "tsx seeds/run-bw-seed.ts",
    "db:seed:instructions": "tsx seeds/run-movement-instructions.ts",
    "db:check": "tsx scripts/check-migration-drift.ts",
    "db:check:ci": "tsx scripts/check-migration-drift.ts"
  },
  "dependencies": {
    "@hta/domain": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "drizzle-zod": "^0.7.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
